# systemd template unit; the instance name is the environment (dev or prod).
[Unit]
Description=wiebkereister.de (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/wiebkereister/%i/current
EnvironmentFile=/etc/wiebkereister/%i.env
ExecStart=/opt/wiebkereister/%i/current/wiebkereister serve
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/wiebkereister/%i

[Install]
WantedBy=multi-user.target
