# Domains and the plain-IP access run side by side. As soon as a domain's DNS
# record points to this server, Caddy obtains a Let's Encrypt certificate for it
# on its own (it keeps retrying until the DNS is correct); no further step needed.
#
#   prod: https://wiebkereister.de        (fallback: http://<IP>/)
#   dev:  https://dev.wiebkereister.de   (fallback: http://<IP>:8081/)
# URLs of the previous WordPress site (known to Google Search Console)
(redirects) {
	redir /sitemap_index.xml /sitemap.xml permanent
	redir /page-sitemap.xml /sitemap.xml permanent
}

wiebkereister.de {
	encode zstd gzip
	import redirects
	reverse_proxy 127.0.0.1:18080
}

www.wiebkereister.de {
	redir https://wiebkereister.de{uri} permanent
}

dev.wiebkereister.de {
	encode zstd gzip
	import redirects
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 127.0.0.1:18081
}

# access by IP (no certificate possible)
http://:80 {
	encode zstd gzip
	import redirects
	reverse_proxy 127.0.0.1:18080
}

http://:8081 {
	encode zstd gzip
	import redirects
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 127.0.0.1:18081
}
